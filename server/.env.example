# Service de contact — copier en server/.env et renseigner les valeurs réelles.
# Ce fichier d'exemple ne contient aucun secret.

# Destinataire des messages du formulaire.
CONTACT_TO=evann.bougoula@dagz.fr
# Expéditeur technique autorisé par le serveur SMTP (ex. une adresse du domaine dagz.fr).
CONTACT_FROM=
# Serveur SMTP d'envoi (hébergeur mail du domaine).
SMTP_HOST=
SMTP_PORT=587
# 1 = TLS implicite (port 465) ; sinon STARTTLS obligatoire.
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Origines autorisées à appeler le service (séparées par des virgules).
ALLOWED_ORIGINS=https://evann-bougoula.dagz.fr
# Limitation de débit : 5 messages par adresse IP toutes les 15 minutes.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
# 1 = aucun envoi réel (test) : le message est seulement journalisé (sans contenu).
CONTACT_DRY_RUN=0
